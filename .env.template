# PaLLi Local environment configuration
# The local repo keeps only the settings that still matter to the local runtime.

# Local Runtime
# Choose development or production mode.
ENVIRONMENT=development

# Select the local deployment profile.
PALLI_DEPLOYMENT_MODE=local

# Keep dormant beta-seat and hosted billing flows disabled in the local fork.
ENABLE_LEGACY_HOSTED_ACCESS=false

# Allow dashboard access without login in local mode.
# Read this before you widen BACKEND_HOST below. true means there is no login
# at all: anyone the bind address and the BACKEND_ALLOWED_NETWORKS gate let
# reach this backend IS the owner as far as PaLLi is concerned — her
# dashboard, her memory, and the chat endpoint, which can reach her shell
# tool. That is safe only because the default bind is loopback (127.0.0.1),
# i.e. this machine and nothing else. Widen the bind and leave this true and
# you have published an unauthenticated shell.
LOCAL_DASHBOARD_NO_AUTH=true

# Set the synthetic local owner email.
LOCAL_OWNER_EMAIL=local@palli.local

# Set the synthetic local owner display name.
LOCAL_OWNER_DISPLAY_NAME="Local Operator"

# The pronouns she uses for you. Set yours here; she also picks them up if you mention them. She never asks.
LOCAL_OWNER_PRONOUNS=they/them

# Point PaLLi at the local SQLite database file.
DATABASE_PATH=data/palli-local.sqlite3

# Which settings file to boot from. Unset means data/palli.yaml (seeded from
# data/palli.example.yaml on the first run).
# PALLI_SETTINGS_PATH=data/palli.yaml

# Set to 1 to skip the live brain and balance checks in `main.py --preflight-only`
# and `palli_ctl.py doctor` — for a machine with no network.
# PALLI_PREFLIGHT_OFFLINE=1

# Public URL the local backend advertises to clients and to the local launcher.
BACKEND_URL=http://127.0.0.1:8000

# Bind address for the FastAPI server.
# 0.0.0.0 exposes the dashboard and the chat endpoint (which can reach
# local_shell) to your whole network, gated only by BACKEND_ALLOWED_NETWORKS below
BACKEND_HOST=127.0.0.1
# Who may reach the backend (2026-08-19): comma-separated CIDRs checked against the
# socket peer. Default = loopback + Tailscale's CGNAT range (100.64.0.0/10) — the LAN
# gets 403. Leave empty to open it to every peer (the old behavior).
BACKEND_ALLOWED_NETWORKS=127.0.0.0/8,::1/128,100.64.0.0/10
# Which names the backend answers to (2026-10-08, against DNS rebinding): localhost and
# any IP address always work. To reach it by a name instead (a LAN or tailnet hostname),
# list that name here, comma-separated. A web page that points its own domain at your
# machine gets a 403 instead of a session.
BACKEND_ALLOWED_HOSTS=
# The local dashboards (venv/bin/python dashboards/server.py, port 3310) answer
# this machine and the tailnet only. To open them to another network as well,
# name it here (comma-separated CIDRs), for example your home network's range:
# DASHBOARDS_TRUSTED_NETWORKS=192.0.2.0/24

# Port for the FastAPI server.
BACKEND_PORT=8000

# Base URL for the local dashboard and packaged local frontend runtime.
FRONTEND_URL=http://localhost:3000

# Host runtime mode.
# Use auto for normal operation, or force linux_x11 / linux_wayland / windows_native during backend testing.
HOST_PLATFORM_MODE=auto

# Emit more verbose host capability diagnostics in runtime and doctor surfaces.
HOST_CAPABILITY_DIAGNOSTICS_VERBOSE=false

# Native Windows notification backend.
WINDOWS_NOTIFICATION_BACKEND=win11toast

# Allow wide-open CORS for trusted local or LAN use.
ALLOW_INSECURE_CORS=true

# LLM
# Pick the default model provider. palli.yaml's llm.default_provider takes
# precedence when the settings service loads — this is the fallback used
# when settings haven't booted yet (early startup, doctor scripts, etc.).
# local_openai = the SHIPPED default: a local Ollama server through its OpenAI-style
# endpoint (LOCAL_LLM_API_BASE). No key, no login — AND her tool calls are real there.
# Do NOT put this key on `ollama`: that is the SAME server through its native door,
# where tool calls are emulated, and `palli_ctl brain` refuses to move her voice to it
# (core/llm_capabilities.py) — she would talk to you and never be able to act. The
# native door is still right for the vision lane, which is where palli.yaml routes it.
# Set LOCAL_LLM_REASONING_EFFORT=none for a Qwen brain. deepseek, anthropic, openai and
# codex are the cloud lanes, each needing its own key or CLI login — all optional.
# Keep this in step with palli.yaml's llm.default_provider
# (tests/core/test_settings_fidelity.py pins it).
# Her voice (the ReAct runner) reads THIS key and LLM_RESPONSE_MODEL — never
# LLM_RESPONSE_PROVIDER, never llm.routing.response. See it or change it:
#   venv/bin/python scripts/palli_ctl.py brain   (2026-09-03, configurator spec §3.4)
# Or set it from a browser: the dashboard's first page picks a brain, tests the
# key live, and writes it to .env.local only if it answers (2026-09-17, the
# first door — .env.local wins over this file, so that is the one it writes).
# She ships with NO brain chosen for you. This names a provider that needs a
# key, and the key below is blank, so a fresh clone boots into SETUP MODE: she
# starts, stays quiet, spends nothing, and the boot line names the dashboard
# address. You pick there, in the browser, and the choice is even — a cloud
# provider (DeepSeek, OpenAI) or a model server on your own machine (Ollama,
# LM Studio, vLLM). None of them is privileged; the door offers all of them.
#
# Setting this to local_openai instead skips the door entirely: a local server
# needs no key, so she boots "ready" and every message comes back as a timeout
# if nothing is actually listening. Change it here only if your server is up.
LLM_PROVIDER=deepseek

# Which reply brain runs. react = the live ReAct agent loop (default);
# pipeline = the legacy tier pipeline, explicit opt-in only.
PALLI_AGENT_LOOP=react

# OpenAI API key for OpenAI-backed calls. The dashboard's first page can set this
# for you — it tests the key live and writes it to .env.local only if it answers.
OPENAI_API_KEY=

# Default OpenAI model name.
OPENAI_MODEL=gpt-4o

# Official local Codex client path used for ChatGPT-backed Codex auth.
CODEX_CLI_PATH=codex

# Default Codex model name when a task routes to Codex CLI.
# Use gpt-5.5 with ChatGPT-auth Codex accounts (the common case).
# gpt-5.1-codex-max requires an API-key Codex account and will be rejected
# by the Codex CLI under ChatGPT auth with "model not supported".
CODEX_MODEL=gpt-5.5

# Optional Codex CLI profile name.
CODEX_PROFILE=

# Optional neutral workspace used for Codex-backed backend requests.
CODEX_WORKDIR=

# Timeout in seconds for a Codex-backed backend request.
CODEX_TIMEOUT_SECONDS=120

# DeepSeek API key for DeepSeek-backed calls. The dashboard's first page can set
# this for you — it tests the key live and writes it to .env.local only if it
# answers.
DEEPSEEK_API_KEY=

# Anthropic API key — fast Haiku aux lanes (caring-memory turn read, cadence,
# stake appraisal) and Claude vision. Optional: nothing in the SHIPPED routing
# uses it (data/palli.example.yaml puts every lane on the local server), so set
# it only if you route a lane to Anthropic yourself. A lane pointed at Anthropic
# without it degrades to the default provider.
ANTHROPIC_API_KEY=

# Default DeepSeek model name.
DEEPSEEK_MODEL=deepseek-chat

# Optional local OpenAI-compatible API base (Ollama, vLLM, LM Studio, etc).
# Reuses Ollama's /v1/chat/completions wire format. Prefer OLLAMA_BASE_URL
# below for native Ollama — the native provider can pass think:false /
# format:json / keep_alive:-1 which the /v1 layer cannot.
LOCAL_LLM_API_BASE=http://127.0.0.1:11434/v1

# Optional API key for the local OpenAI-compatible backend.
LOCAL_LLM_API_KEY=

# Default model name used when a task routes to the local backend. Ships matching
# palli.yaml's nine text lanes: `ollama pull qwen3.5:9b`.
LOCAL_LLM_MODEL=qwen3.5:9b

# Native Ollama backend base URL (used by ai/llm_ollama.py via /api/chat).
# Override in .env.local — e.g. http://192.0.2.8:11434 to point at a LAN
# GPU host. Leave at 127.0.0.1 for a local Ollama instance.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Default model for the NATIVE Ollama door. In the shipped config that door serves
# one lane — vision, the half of the server that has eyes — and palli.yaml names
# gemma3:12b there explicitly. `ollama pull gemma3:12b`.
OLLAMA_MODEL=gemma3:12b

# Ollama request timeout in seconds. Default 180s tolerates first-call
# model loads on cold GPU; warm responses are sub-10s.
OLLAMA_TIMEOUT_SECONDS=180

# The Claude CLI's own default model, used when a lane routes to provider:
# claude (the subscription CLI on this box). Declared 2026-09-04; empty or
# unset = the provider's built-in haiku. Uncomment to pin one.
# CLAUDE_CLI_MODEL=sonnet

# Model used for final user-facing replies — HER VOICE. Read together with
# LLM_PROVIDER above (never llm.routing.response), so it must name a model THAT
# provider serves. Ships matching the ollama-primary preset; `palli_ctl brain`
# rewrites this line and the yaml together.
LLM_RESPONSE_MODEL=qwen3.5:9b

# How loose her replies are (0 = the same words every time; higher = more varied).
# Leave it blank to use the provider's own default. gpt-5 and o-series brains never get it.
LLM_REPLY_TEMPERATURE=0.9

# How long her reply call waits for the brain to send anything (keep-alive pings do not
# count) before it tries once more, then tells you it failed. Unset = 90 seconds, or 300
# for local_openai (a local server sends nothing while it loads a model or reads a long
# prompt). Uncomment to set.
# LLM_REPLY_READ_TIMEOUT_SECONDS=90

# Optional provider override for final user-facing replies.
LLM_RESPONSE_PROVIDER=

# Model for the fast cadence/shape pass (should-respond, register, pacing) — one call
# per reply. Accepts provider::model cross-provider syntax. EMPTY on purpose: the
# judge then follows her voice, which is the local model, and a fresh install needs
# no key for it. Naming a cloud model here (it used to say
# anthropic::claude-haiku-4-5) sends every single reply through a provider whose key
# a stranger has not set.
CADENCE_MODEL=

# Model used for analysis and classification tasks.
LLM_ANALYSIS_MODEL=gpt-4.1-mini

# Optional provider override for analysis and classification tasks.
LLM_ANALYSIS_PROVIDER=

# Model used for memory and profile extraction.
LLM_MEMORY_MODEL=gpt-4.1-mini

# Optional provider override for memory and profile extraction.
LLM_MEMORY_PROVIDER=

# Model used for decisions and guardrails.
LLM_DECISION_MODEL=gpt-4.1-mini

# Optional provider override for decisions and guardrails.
LLM_DECISION_PROVIDER=

# Model used for proactive message generation.
LLM_PROACTIVE_MODEL=gpt-4o

# Optional provider override for proactive generation.
LLM_PROACTIVE_PROVIDER=

# Model used for bounded reflection and deeper continuity updates.
LLM_REFLECTION_MODEL=gpt-4.1-mini

# Optional provider override for bounded reflection.
LLM_REFLECTION_PROVIDER=

# Model used for web-search judgment and summarization.
LLM_WEB_SEARCH_MODEL=gpt-4o-mini

# Optional provider override for web-search judgment and summarization.
LLM_WEB_SEARCH_PROVIDER=

# Model used for image and vision tasks.
LLM_VISION_MODEL=gpt-4o

# Optional provider override for image and vision tasks.
LLM_VISION_PROVIDER=

# Discord Integration
# Enable the Discord bot runtime. Discord is optional at your first boot: with
# no token below she starts anyway, warns that the Discord door is closed for
# this boot, and waits for you on the dashboard and the backend instead.
ENABLE_DISCORD_BOT=true

# Discord bot token. Blank means Discord is off for this boot (a warning, never
# a refusal to start). Put yours here when you want her on Discord — SETUP.md
# section 2 covers the application and the three privileged intents.
DISCORD_TOKEN=

# Primary guild ID for local Discord defaults.
DISCORD_PRIMARY_GUILD_ID=

# Optional Discord role ID kept for compatibility.
DISCORD_FOUNDING_MEMBER_ROLE_ID=

# How long to keep Discord dedup entries.
DISCORD_DEDUP_TTL_SECONDS=600

# Maximum size of the Discord dedup cache.
DISCORD_DEDUP_MAX_SIZE=20000

# Telegram Integration
# Enable the Telegram bot runtime. OFF by default: an install that has never
# heard of Telegram grows nothing new and is told nothing about it. Flip this
# to true once you have a token on the line below.
ENABLE_TELEGRAM_BOT=false

# Telegram bot token, from @BotFather's /newbot. With the door on above, blank
# means the Telegram door is closed for this boot — a warning, never a refusal
# to start. With the door off there is nothing to warn about and she says
# nothing. SETUP.md section 2b is the five-line walk-through.
TELEGRAM_BOT_TOKEN=

# The phone app (the mobile door). OFF by default: an install that never
# asked for it grows nothing new. It has no token — a phone pairs with a
# one-use code from the door page or `palli_ctl phone pair`. SETUP.md
# section 2c is the walk-through.
ENABLE_MOBILE_DOOR=false

# Where your phone reaches this backend, put in the pairing QR. Over
# Tailscale: http://<host>.<tailnet>.ts.net:8000 (add that name to
# BACKEND_ALLOWED_HOSTS) or http://<tailscale-ip>:8000. Blank: the app asks
# for the address by hand. A phone can only reach a backend that listens
# beyond this machine (BACKEND_HOST=0.0.0.0).
MOBILE_PUBLIC_URL=

# Guest budget. Anyone who is not the owner is a guest, and every guest turn
# she takes is an LLM call on YOUR key. This caps how many guest turns run at
# the same moment, across everyone (default 2). A guest message over it waits
# its turn — no automatic "at capacity" reply — and she reads it once a slot
# is free:
# GUEST_MAX_IN_FLIGHT=2

# Deepgram API key for voice transcription.
DEEPGRAM_API_KEY=

# Cartesia API key for alternate voice synthesis.
CARTESIA_API_KEY=

# Exa API key for web search.
EXA_API_KEY=

# Warn when the provider balance falls below this (in the account's currency).
# LLM_LOW_BALANCE_WARN=2.0

# Identity
# Enable the file-backed identity system.
ENABLE_IDENTITY_ARCHITECTURE=true

# Root directory for identity markdown files.
IDENTITY_ROOT_PATH=identity

# Allow identity edits from the dashboard.
IDENTITY_ENABLE_DASHBOARD_EDITING=true

# Allow chat-driven identity edits.
IDENTITY_ENABLE_CHAT_EDITING=true

# Let PaLLi silently maintain evolving identity docs.
IDENTITY_ENABLE_SILENT_SELF_MAINTENANCE=true

# Allow privileged autonomy inside the hard safety gates.
IDENTITY_ENABLE_PRIVILEGED_AUTONOMY=false

# Cooldown between background identity-analysis passes.
IDENTITY_CHAT_ANALYSIS_COOLDOWN_SECONDS=900

# Enable the bounded reflection feature.
ENABLE_BOUNDED_REFLECTION=true

# Cooldown between post-conversation reflection passes.
BOUNDED_REFLECTION_POST_TURN_COOLDOWN_SECONDS=21600

# Periodic bounded-reflection loop interval.
BOUNDED_REFLECTION_PERIODIC_INTERVAL_MINUTES=360

# Require recent activity before periodic reflection runs.
BOUNDED_REFLECTION_ACTIVITY_LOOKBACK_HOURS=72

# Enable the markdown-first memory workspace.
MEMORY_WORKSPACE_ENABLED=true

# Enable indexing/search for curated memory, daily logs, workflow memories, and followthrough.
MEMORY_INDEX_ENABLED=true

# Prefer bundled local embeddings for semantic memory search.
MEMORY_LOCAL_EMBEDDINGS_ENABLED=true

# Default local embedding model for memory search.
MEMORY_LOCAL_EMBEDDINGS_MODEL=all-MiniLM-L6-v2

# Remote fallback embedding model when the local model is unavailable.
MEMORY_REMOTE_EMBEDDINGS_MODEL=text-embedding-3-small

# Default number of memory search results to return.
MEMORY_SEARCH_TOP_K=8

# Maximum number of retrieved memory items to inject into reply context.
MEMORY_SEARCH_MAX_CONTEXT_ITEMS=4

# Enable the backend plugin/capability runtime.
PLUGIN_RUNTIME_ENABLED=true

# Comma-separated local plugin directories.
PLUGIN_DIRECTORIES=plugins

# Plugin runtime API version used for manifest compatibility checks.
PLUGIN_API_VERSION=1

# Discover plugins during startup and launcher doctor checks.
PLUGIN_DISCOVER_ON_START=true

# Maximum automatic delivery-resume attempts during startup recovery.
RUNTIME_MAX_RECOVERY_RESUME_ATTEMPTS=1

# Maximum bounded automatic surface-recovery attempts per action.
SURFACE_RELIABILITY_MAX_AUTO_RECOVERY_ATTEMPTS=1

# Home/presence context
# E.5 Wave 4 step 3 (2026-05-13): HOME_ASSISTANT_ENABLED moved to
# data/palli.yaml -> features.home_assistant. The URL/TOKEN below
# remain in env per the capped-scope decision (per-environment
# secrets, not config).

# Base URL for the Home Assistant instance.
HOME_ASSISTANT_URL=

# Long-lived Home Assistant token.
HOME_ASSISTANT_TOKEN=

# Verify Home Assistant TLS certificates.
HOME_ASSISTANT_VERIFY_SSL=true

# Comma-separated owner presence entities (person.*, device_tracker.*, binary_sensor.*).
HOME_ASSISTANT_OWNER_ENTITY_IDS=

# Comma-separated entities that imply a private context.
HOME_ASSISTANT_PRIVATE_ENTITY_IDS=

# Comma-separated entities that imply a shared context.
HOME_ASSISTANT_SHARED_ENTITY_IDS=

# Enable local machine lock/unlock/idle/activity sensing.
LOCAL_MACHINE_PRESENCE_ENABLED=true

# Poll interval for local machine presence checks.
LOCAL_MACHINE_PRESENCE_POLL_SECONDS=10

# How often to reconcile full home context from sources.
HOME_CONTEXT_RECONCILE_SECONDS=120

# Dedupe window for repeated context events.
HOME_CONTEXT_EVENT_DEDUP_SECONDS=20

# Cooldown between arrival greetings.
AMBIENT_ARRIVAL_COOLDOWN_SECONDS=1800

# Grace window to delay greeting until the machine is active/unlocked.
AMBIENT_MACHINE_UNLOCK_GRACE_SECONDS=180

# Minimum time (seconds) the machine must remain locked before an unlock
# transition is treated as an owner arrival. Defaults to 10 minutes.
AMBIENT_ARRIVAL_LOCKED_THRESHOLD_SECONDS=600

# Minimum time (seconds) the machine must remain idle before return-to-active
# is treated as an owner arrival. Idle is a weaker signal than lock, so this
# defaults to a longer window (20 minutes) to filter screensaver-triggered
# false positives during long video calls.
AMBIENT_ARRIVAL_IDLE_THRESHOLD_SECONDS=1200

# Machine operator adapters
# Enable the persistent Playwright Chromium browser adapter.
OPERATOR_BROWSER_ENABLED=true

# Local profile directory for PaLLi's browser session.
OPERATOR_BROWSER_PROFILE_DIR=data/operator-browser/profiles

# Download directory for browser-driven operator work.
OPERATOR_BROWSER_DOWNLOADS_DIR=data/operator-browser/downloads

# Run the operator browser headless instead of visible.
OPERATOR_BROWSER_HEADLESS=false

# Enable Linux desktop adapters like xdg-open, wmctrl, xdotool, and notify-send.
OPERATOR_DESKTOP_ENABLED=true

# Allow desktop focus, typing, key, and click control.
OPERATOR_DESKTOP_ALLOW_INPUT_CONTROL=true

# Refresh cadence for adapter health snapshots.
OPERATOR_ADAPTER_HEALTH_POLL_SECONDS=30

# Enable desktop screenshot/OCR/vision inspection.
OPERATOR_DESKTOP_VISION_ENABLED=true

# Local directory for retained desktop captures.
OPERATOR_SCREENSHOT_DIR=data/operator-desktop/captures

# How long desktop captures are kept on disk.
OPERATOR_SCREENSHOT_RETENTION_SECONDS=1800

# Enable OCR during desktop inspection when dependencies exist.
OPERATOR_OCR_ENABLED=true

# Maximum age for an inspection before target actions require refresh.
OPERATOR_VISION_INSPECTION_MAX_AGE_SECONDS=300

# Agentic
# Enable the agentic task-execution loop.
AGENTIC_ENABLED=true

# Choose the routing mode for agentic work.
AGENTIC_MODE=hybrid

# Choose shadow or enforce execution behavior.
AGENTIC_ROLLOUT_MODE=enforce

# Maximum steps allowed in one run.
AGENTIC_MAX_STEPS=10

# Timeout for a single agentic step.
AGENTIC_STEP_TIMEOUT_SECONDS=300

# Timeout for an entire agentic run.
AGENTIC_RUN_TIMEOUT_SECONDS=300

# Confidence needed to route into agentic mode.
AGENTIC_ROUTE_CONFIDENCE_THRESHOLD=0.55

# Restrict agentic execution to DMs only.
AGENTIC_DM_ONLY=false

# Filesystem root the agentic shell may operate within.
AGENTIC_WORKSPACE_ROOT=.

# Allow autonomous shell actions when policy permits.
AGENTIC_ALLOW_AUTONOMOUS_CLI=true

# Allow package-manager installs through agentic execution.
AGENTIC_ALLOW_PACKAGE_INSTALLS=true

# Require confirmation before install actions.
AGENTIC_INSTALL_CONFIRM_REQUIRED=false

# Reuse matching pending confirmations when possible.
AGENTIC_CONFIRM_REUSE_EXISTING_TOKEN=true

# Cap unresolved confirmations per user.
AGENTIC_MAX_PENDING_CONFIRMATIONS_PER_USER=3

# How long confirmation tokens stay valid.
AGENTIC_CONFIRM_TIMEOUT_SECONDS=600

# Resume the run automatically after approval.
AGENTIC_AUTO_RESUME_AFTER_APPROVAL=true

# Step budget after a confirmed action.
AGENTIC_POST_CONFIRM_MAX_STEPS=3

# Timeout for post-confirmation work.
AGENTIC_POST_CONFIRM_TIMEOUT_SECONDS=60

# Limit repeated command retries in one run.
AGENTIC_MAX_SAME_COMMAND_ATTEMPTS_PER_RUN=2

# Clamp stored command output length.
AGENTIC_MAX_COMMAND_OUTPUT_CHARS=6000

# Choose how queued user messages are merged into active work.
AGENTIC_QUEUE_MODE=collect

# Delay before queued control messages are processed.
AGENTIC_QUEUE_DEBOUNCE_MS=1000

# Maximum queued control items per session.
AGENTIC_QUEUE_CAP=20

# Allow natural-language control of active runs.
AGENTIC_NL_CONTROL_ENABLED=true

# Require active work before NL control commands apply.
AGENTIC_CONTROL_REQUIRE_ACTIVE_WORK=true

# Choose how wide cancel requests apply.
AGENTIC_CONTROL_CANCEL_SCOPE=run_and_descendants

# Choose how redirect requests steer running work.
AGENTIC_CONTROL_REDIRECT_MODE=replace_goal

# Choose how stale confirmations are handled.
AGENTIC_STALE_CONFIRMATION_POLICY=supersede

# Enable or disable automatic lane routing.
AGENTIC_LANE_ROUTING_MODE=auto

# How long idle sessions stay alive before archive.
AGENTIC_SESSION_IDLE_TTL_SECONDS=1800

# How long archived sessions are kept.
AGENTIC_SESSION_ARCHIVE_RETENTION_DAYS=14

# Maximum reply-back rounds for delegated work.
AGENTIC_SESSION_REPLY_BACK_MAX_ROUNDS=1

# Step count that triggers context compaction.
AGENTIC_COMPACTION_TRIGGER_STEPS=6

# Recent observations preserved during compaction.
AGENTIC_COMPACTION_RECENT_OBSERVATIONS=4

# Recent history lines preserved during compaction.
AGENTIC_COMPACTION_RECENT_HISTORY_LINES=8

# Retry limit for model planning failures.
AGENTIC_MODEL_RETRY_MAX_ATTEMPTS=1

# Retry limit for tool failures.
AGENTIC_TOOL_RETRY_MAX_ATTEMPTS=1

# Token budget for one root run.
AGENTIC_MAX_RUN_TOKENS=24000

# Step budget for child runs.
AGENTIC_CHILD_MAX_STEPS=4

# Timeout for child runs.
AGENTIC_CHILD_RUN_TIMEOUT_SECONDS=90

# Token budget for child runs.
AGENTIC_CHILD_MAX_RUN_TOKENS=8000

# Maximum child runs under one root run.
AGENTIC_ROOT_MAX_CHILD_RUNS=6

# Total child-run time budget for one root run.
AGENTIC_ROOT_MAX_CHILD_TOTAL_SECONDS=240

# Total child-run token budget for one root run.
AGENTIC_ROOT_MAX_CHILD_TOTAL_TOKENS=32000

# Warn when a run nears its token or time budget.
AGENTIC_BUDGET_WARN_RATIO=0.8

# Stream intermediate agentic output when possible.
AGENTIC_STREAMING_ENABLED=true

# Choose how streamed agentic chunks are broken up.
AGENTIC_STREAMING_BREAK=text_end

# Minimum chars before emitting a stream chunk.
AGENTIC_STREAMING_MIN_CHARS=140

# Maximum chars in one streamed chunk.
AGENTIC_STREAMING_MAX_CHARS=1200

# Idle wait before flushing streamed output.
AGENTIC_STREAMING_IDLE_MS=450

# Enable subagent delegation in the local runtime.
AGENTIC_SUBAGENTS_ENABLED=false

# Choose how Discord previews agentic work.
# - off: no preview message
# - partial: live edited preview updates while the run executes
# - block: final-only delivery (no live edited preview updates)
DISCORD_AGENTIC_PREVIEW_MODE=block

# Discord user IDs allowed to use agentic execution.
AGENTIC_ALLOWED_DISCORD_USER_IDS=

# Discord user IDs allowed to request debug traces.
AGENTIC_DEBUG_ALLOW_USER_IDS=

# -----------------------------------------------------------------------------
# Autonomous research + install tool surface
# -----------------------------------------------------------------------------

# Root directory for files downloaded via the download_file tool.
# Relative to the project root. Files written here are contained to this
# directory by path-traversal protection in ai/agentic/download_tool.py.
AGENT_DOWNLOAD_ROOT=data/agent_downloads

# Maximum single-file download size in bytes. Downloads exceeding this are
# rejected before any bytes are written to disk. Defaults to 100 MB.
AGENT_DOWNLOAD_MAX_BYTES=104857600

# Persistent browser profile directory for Playwright sessions. Leave empty
# for an ephemeral context per session (cookies and logins do not persist).
# Set to a directory path to enable persistence across sessions.
AGENTIC_BROWSER_PROFILE_DIR=

# Run Playwright Chromium headless (true) or visible (false). Defaults to
# headless; set to false during local debugging to watch the browser work.
AGENTIC_BROWSER_HEADLESS=true

# Core Features
# Enable the voice runtime. OFF by default: on, it needs an STT provider
# (DEEPGRAM_API_KEY, or STT_PROVIDER=faster_whisper + VOICE_LOCAL_STT_MODEL) and a
